{
  "name": "bitovi-shop",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "node shared/scripts/kill-port.js 3001 && node backend/index.js",
    "frontend": "node shared/scripts/kill-port.js 5173 && vite --config frontend/vite.config.js --host",
    "mcp:sql": "node backend/mcps/sql/index.js",
    "mcp:shop": "node backend/mcps/shop/index.js",
    "build": "npm run build:frontend",
    "test": "vitest run --config frontend/vite.config.js",
    "test:watch": "vitest --config frontend/vite.config.js",
    "build:frontend": "vite build --config frontend/vite.config.js",
    "figma:publish": "figma connect publish",
    "figma:unpublish": "figma connect unpublish",
    "figma:parse": "figma connect parse",
    "figma:check": "node shared/scripts/check-code-connect.js",
    "mocks:build": "node shared/scripts/mocks.js build",
    "mocks:check": "node shared/scripts/mocks.js check",
    "mocks:bundle": "node shared/scripts/mocks.js bundle",
    "prototype:share": "node shared/scripts/share-prototype.js",
    "mcp:design-rules": "node backend/mcps/design-rules/index.js",
    "rules:build": "node design-rules/build.mjs",
    "rules:approve": "node design-rules/approve.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.13.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.4.9",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "jsdom": "^22.1.0",
    "vite": "^4.5.14",
    "vitest": "^0.34.6"
  },
  "engines": {
    "node": "24.4.1",
    "npm": ">=10.0.0"
  }
}
