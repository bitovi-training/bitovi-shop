# Figma personal access token — required for Code Connect CLI (publish/unpublish/create)
# Create one at: https://www.figma.com/settings > Personal access tokens
# Required scopes (check only these): file_code_connect:write (Development)
# and file_content:read (Files).
# Must belong to an org member (not a guest); plan-level tokens do not work.
FIGMA_ACCESS_TOKEN=your_token_here
